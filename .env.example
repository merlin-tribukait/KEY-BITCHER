# Example .env file for key-bitcher
# Copy to `.env`, fill in your own keys, then run `key-bitcher sync-secrets`.
# NEVER commit real secrets. The real `.env` is gitignored.

# --- AWS / Backblaze B2 (used to reach the secrets bucket) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-003"

# --- AI provider keys (synced from S3; used by benchmark + Wave import) ---
OPENAI_API_KEY=""
OPENAI_API_KEY_2=""
OPENROUTER_API_KEY=""
OPENROUTER_API_KEY_ALT=""
ANTHROPIC_API_KEY=""
ANTHROPIC_API_KEY_2=""
ANTHROPIC_API_KEY_3=""
MISTRAL_API_KEY=""
GOOGLE_API_KEY=""
GOOGLE_API_KEY_2=""
GOOGLE_API_KEY_3=""
NVIDIA_API_KEY=""
NVIDIA_API_KEY_ALT=""
DEEPSEEK_API_KEY=""
CEREBRAS_API_KEY=""
COHERE_API_KEY=""
XAI_API_KEY=""
HF_TOKEN=""
HF_TOKEN_ALT=""
ELEVENLABS_API_KEY=""
DEEPGRAM_API_KEY=""
STABILITY_API_KEY=""
OLLAMA_API_KEY=""
GROQ_API_KEY=""

# --- Non-AI tokens (optional) ---
CLOUDFLARE_API_TOKEN=""
VERCEL_TOKEN=""
GITHUB_TOKEN=""
QDRANT_API_KEY=""
AI_GATEWAY_API_KEY=""
